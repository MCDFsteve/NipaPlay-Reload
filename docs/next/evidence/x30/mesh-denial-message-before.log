main nipa describe download.delete {"id": "download.delete", "title": "delete download", "description": "Delete session entries and data for jobId or jobIds. Each item checks output containment and records its own destructive audit, including failures. Returns a disk_deletion task in job. For download.delete, input jobId/jobIds identify downloads; the returned job.jobId identifies a separate deletion task. One user prompt covers the entire requested batch. Only a person clicking Delete in NipaPlay can authorize disk deletion. waiting_user means no deletion has run; task.wait and followup.register can observe it. A refusal fails with 用户没有同意删除. No confirmation or execute argument bypasses this gate.", "effect": "destructive", "inputSchema": {"type": "object", "properties": {"jobId": {"type": "string", "minLength": 1}, "jobIds": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false, "oneOf": [{"required": ["jobId"]}, {"required": ["jobIds"]}]}, "outputSchema": {"type": "object", "properties": {"job": {"type": "object", "properties": {}, "additionalProperties": true}}, "required": ["job"], "additionalProperties": false}}
main nipa describe plugins.delete {"id": "plugins.delete", "title": "删除插件", "description": "停用并删除本地插件脚本和索引；Classic 内置插件不能删除。 支持 operations 批量；每项可附 reason，成功项不会因其他项失败回滚。 Returns a disk_deletion task in job. For download.delete, input jobId/jobIds identify downloads; the returned job.jobId identifies a separate deletion task. One user prompt covers the entire requested batch. Only a person clicking Delete in NipaPlay can authorize disk deletion. waiting_user means no deletion has run; task.wait and followup.register can observe it. A refusal fails with 用户没有同意删除. No confirmation or execute argument bypasses this gate.", "effect": "destructive", "inputSchema": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "reason": {"type": "string"}, "operations": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1}, "reason": {"type": "string"}}, "required": ["id"], "additionalProperties": false}}}, "additionalProperties": false, "oneOf": [{"required": ["id"]}, {"required": ["operations"]}]}, "outputSchema": {"type": "object", "properties": {"job": {"type": "object", "properties": {}, "additionalProperties": true}}, "required": ["job"], "additionalProperties": false}}
main nipa describe media.sources.remove {"id": "media.sources.remove", "title": "Remove a media source", "description": "Remove a source connection without confirmation. Indexed file identities, bindings and playback history remain; no disk files are deleted.", "effect": "destructive", "inputSchema": {"type": "object", "properties": {"sourceId": {"type": "string", "minLength": 1}}, "required": ["sourceId"], "additionalProperties": false}, "outputSchema": {"type": "object", "properties": {"sourceId": {"type": "string", "minLength": 1}, "removed": {"type": "boolean"}, "indexedFilesPreserved": {"type": "boolean"}, "source": {"type": "object", "properties": {"sourceId": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "url": {"type": "string", "minLength": 1}, "username": {"type": "string"}, "connected": {"type": "boolean"}, "connectionState": {"type": "string", "enum": ["connected", "unverified"]}, "selectedLibraries": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "required": ["sourceId", "type", "name", "url", "username", "connected", "connectionState", "selectedLibraries"], "additionalProperties": false}}, "required": ["sourceId", "removed", "indexedFilesPreserved"], "additionalProperties": false}}
main nipa describe backup.restore {"id": "backup.restore", "title": "恢复全量备份", "description": "按选定类别调用 Classic .npb 恢复，会合并或改写持久数据。禁止设置保留现值并返回 forbidden_setting；注册设置经过 settings.set 的 Classic 校验与交互。凭据只能恢复本机已有引用，不能输入新的登录秘密。返回各类别实际结果；部分服务需要重启应用生效。来源记录保留本次调用者、时间与原因。 支持 operations 批量；每项可附 reason，成功项不会因其他项失败回滚。", "effect": "destructive", "inputSchema": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "categories": {"type": "array", "items": {"type": "string", "enum": ["preferences", "mediaLibraries", "watchHistory", "episodeMatches", "accounts"]}}, "reason": {"type": "string"}, "operations": {"type": "array", "items": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "categories": {"type": "array", "items": {"type": "string", "enum": ["preferences", "mediaLibraries", "watchHistory", "episodeMatches", "accounts"]}}, "reason": {"type": "string"}}, "required": ["path", "categories"], "additionalProperties": false}}}, "additionalProperties": false, "oneOf": [{"required": ["path", "categories"]}, {"required": ["operations"]}]}, "outputSchema": {"type": "object", "properties": {}, "additionalProperties": true}}
main nipa describe danmaku.import {"id": "danmaku.import", "title": "danmaku.import", "description": "Import acquired danmaku using Classic local XML/JSON parsing and encoding support, including ARGB colors. Also accepts normalized JSON arrays (or {comments:[...]}): sourceTimeMs (nonnegative integer milliseconds), text, mode (positive integer), colorRgb (nonnegative integer, converted to RGB); optional platformId, sourceEntryId, originSource, sender, sentAt (strings), fontSize (positive integer). No registered source is required. Supply platform/platformVideoId; host records actor, origin and timestamp. Target entityId (file or episode), path, or current playback (default). Reimport replaces the same platform/video pool atomically, preserving track settings; empty or malformed files are rejected and leave the old track unchanged. Mounted immediately when the target is playing. File data stays in host storage; do not send large comment arrays through tool arguments.", "effect": "write", "inputSchema": {"type": "object", "properties": {"filePath": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}, "platformVideoId": {"type": "string", "minLength": 1}, "entityId": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "current": {"type": "boolean"}, "note": {"type": "string"}}, "required": ["filePath", "platform", "platformVideoId"], "additionalProperties": false}, "outputSchema": {"type": "object", "properties": {"bindingId": {"type": "string", "minLength": 1}, "revision": {"type": "integer"}, "count": {"type": "integer"}, "loaded": {"type": "boolean"}, "provenance": {"type": "object", "properties": {"platform": {"type": "string", "minLength": 1}, "platformVideoId": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "origin": {"type": "string", "minLength": 1}, "importedAt": {"type": "string", "minLength": 1}, "filePath": {"type": "string", "minLength": 1}, "note": {"type": ["string", "null"]}}, "required": ["platform", "platformVideoId", "actor", "origin", "importedAt", "filePath", "note"], "additionalProperties": false}}, "required": ["bindingId", "revision", "count", "loaded", "provenance"], "additionalProperties": false}}
